_gt_msg() {
  local key=$1 template
  shift
  if [[ ${GTTERM_LANG:-en} == tr ]]; then
    template=${_GT_TR[$key]:-${_GT_EN[$key]:-$key}}
  else
    template=${_GT_EN[$key]:-$key}
  fi
  printf -- "$template\n" "$@"
}
